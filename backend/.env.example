# Server Configuration
PORT=5000
NODE_ENV=development
# Allowed Frontend Origin(s) for CORS (single URL or comma-separated list)
FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app

# Database Connection (MongoDB)
MONGO_URI=mongodb://localhost:27017/expense_tracker

# Clerk Authentication (Test / Dev instance)
CLERK_SECRET_KEY=sk_test_example_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_example_clerk_publishable_key

# Manual UPI Payment Configuration
UPI_PAYEE_VPA=example@bank
UPI_PAYEE_NAME=FinTrack Payments

# AI Features (Optional / Demo)
GEMINI_API_KEY=example_gemini_api_key
